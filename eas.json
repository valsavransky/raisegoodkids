{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "channel": "production"
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {},
    "testflight": {}
  }
}
