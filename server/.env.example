# Railway sets DATABASE_URL automatically when this service is linked to the
# Postgres service in the same project (via a variable reference) — you
# don't need to set it by hand there.
DATABASE_URL=postgresql://user:password@localhost:5432/merit

# A long random string used to sign login tokens. Generate one (e.g.
# `openssl rand -hex 32`) and set it in Railway's Variables tab — never
# commit a real value here.
JWT_SECRET=replace-with-a-random-string

PORT=3000
