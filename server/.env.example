# Railway sets DATABASE_URL automatically when this service is linked to the
# Postgres service in the same project (via a variable reference) — you
# don't need to set it by hand there.
DATABASE_URL=postgresql://user:password@localhost:5432/merit

# A long random string used to sign login tokens. Generate one (e.g.
# `openssl rand -hex 32`) and set it in Railway's Variables tab — never
# commit a real value here.
JWT_SECRET=replace-with-a-random-string

PORT=3000

# Optional. Powers Tier 1 "smarter goal recommendations" — when a goal name
# doesn't match any static keyword (see src/data/goalIdeas.ts), the server
# asks Claude to categorize it instead. Set this in Railway's Variables tab
# to turn that on; left unset, /goals/classify-category just returns
# { category: null } and the app falls back to keyword-only matching.
ANTHROPIC_API_KEY=

# Required for "Sign in with Google" (POST /auth/google). Same client IDs
# the app already uses for Google Calendar access — see app.json's
# extra.googleCalendar.iosClientId/androidClientId, copy those exact
# values here. Left unset, /auth/google returns a 500 rather than accepting
# an unverifiable token.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
